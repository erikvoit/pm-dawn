#!/usr/bin/env bash
set -euo pipefail

server="${ACLI_SERVER:-https://rpv.atlassian.net}"
user_email="${ACLI_USER:-$(git config --get user.email || true)}"

if [[ -z "${user_email}" ]]; then
  echo "ACLI_USER is not set and git user.email is unavailable; set ACLI_USER before logging in." >&2
  exit 1
fi

security find-generic-password -a "$USER" -s jira-acli-token -w |
  acli jira auth login --site "${server#https://}" --email "$user_email" --token
